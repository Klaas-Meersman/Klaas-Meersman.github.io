---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";

// Courses I'm involved in. Add new entries here as they come up.
// `url` links the course name to its page in the KU Leuven course catalogue.
// Use the unprefixed URL — the year-prefixed one (.../2026/syllabi/...) is not
// public yet and returns an error for visitors without a KU Leuven login.
// `materials` lists optional extra pages (e.g. interactive demos in public/teaching/).
const teaching = [
  {
    role: "Teaching assistant",
    course: "Communication Networks",
    url: "https://onderwijsaanbod.kuleuven.be/syllabi/v/e/JPI13Q.htm",
    detail: "KU Leuven, Ghent Technology Campus",
    period: "2026 – present",
  },
  {
    role: "Teaching assistant",
    course: "Electromagnetic Waves and Antennas",
    url: "https://onderwijsaanbod.kuleuven.be/syllabi/v/e/JPI123.htm",
    detail: "KU Leuven, Ghent Technology Campus",
    period: "2026 – present",
    materials: [
      {
        title: "Interactive: polarisation from γ and φ",
        url: "/teaching/em-waves/polarisation/",
      },
    ],
  },
];
---

<BaseLayout
  title="Teaching"
  description="Teaching and student supervision by Klaas Meersman."
>
  <h1>Teaching</h1>
  <p class="lead">Courses I help teach at KU Leuven's Ghent Technology Campus.</p>

  <ul class="teach-list">
    {
      teaching.map((t) => (
        <li>
          <strong>{t.role}</strong> —{" "}
          {t.url ? <a href={t.url}>{t.course}</a> : t.course}
          <div class="muted small">
            {t.detail} · {t.period}
          </div>
          {t.materials && (
            <ul class="materials">
              {t.materials.map((m) => (
                <li>
                  <a href={m.url}>{m.title}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <h2>Interested in a thesis topic?</h2>
  <p>
    If you're a student looking for a thesis or internship around lighting,
    daylight simulation, or VR, feel free to
    <a href={`mailto:${SITE.email}`}>get in touch</a>. I'm always happy to talk
    through ideas.
  </p>
</BaseLayout>

<style>
  .teach-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .teach-list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .materials {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.95rem;
  }
  .materials li {
    padding: 0.1rem 0;
    border-bottom: none;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }
</style>
