---
import BaseLayout from "../layouts/BaseLayout.astro";
import ObjectiveDiagram from "../components/ObjectiveDiagram.astro";
import { objectives } from "../data/objectives";
---

<BaseLayout
  title="Research"
  description="Research objectives of Klaas Meersman — a high-fidelity VR framework for human-centric evaluation of spatially adaptive lighting."
>
  <h1>Research</h1>
  <p class="lead">
    Spatially adaptive lighting technology is here, but its integration into
    human-centric lighting design still lags behind.
  </p>
  <p>
    The hardware exists: micro-LED arrays with projection optics, camera sensors
    for luminance and occupancy, and proven dynamic light shaping. What's missing
    are perception-based control strategies, evaluation frameworks, and
    human-centric design methods. VR lets us evaluate
    lighting scenarios repeatedly under identical emulated room and daylight
    conditions.
  </p>

  <h2>Objectives</h2>
  <div class="obj-grid">
    {
      objectives.map((o, i) => (
        <article class="card">
          <div class="obj-fig">
            <ObjectiveDiagram name={o.diagram} label={o.label} />
          </div>
          <p class="obj-n">Objective {i + 1}</p>
          <h3>{o.title}</h3>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .obj-n {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .obj-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .obj-grid .card {
    margin: 0;
  }
  .obj-fig {
    background: var(--bg-soft);
    border-radius: 8px;
    padding: 0.5rem;
    margin-bottom: 0.8rem;
  }
  .card h3 {
    margin: 0.15rem 0 0;
  }
  @media (max-width: 560px) {
    .obj-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
