---
// "KM" logo mark: a solid square with K, overlapped by an outlined square
// with M. Colours come from --mark-ink and --mark-paper, so the same mark
// works in the header (dark on light) and the footer (light on dark).
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<svg
  class="mark"
  viewBox="0 0 44 40"
  width={Math.round((size * 44) / 40)}
  height={size}
  aria-hidden="true"
>
  <rect class="solid" x="1" y="1" width="24" height="24" rx="2" />
  <text class="on-solid" x="5" y="19.5">K</text>
  <rect class="outline" x="17.5" y="13.5" width="24" height="24" rx="2" />
  <text class="on-outline" x="29.5" y="32" text-anchor="middle">M</text>
</svg>

<style>
  .mark {
    display: block;
    flex: none;
  }
  .solid {
    fill: var(--mark-ink, var(--text));
  }
  .outline {
    fill: var(--mark-paper, var(--bg));
    stroke: var(--mark-ink, var(--text));
    stroke-width: 2.6;
  }
  text {
    font: 700 17px var(--font-sans);
  }
  .on-solid {
    fill: var(--mark-paper, var(--bg));
  }
  .on-outline {
    fill: var(--mark-ink, var(--text));
    font-size: 15px;
  }
</style>
