---
import { SITE, LINKS } from "../consts";
import Monogram from "./Monogram.astro";

const year = new Date().getFullYear();

// Only show links that have a value in consts.ts.
const social = [
  { label: "Email", href: LINKS.email },
  { label: "KU Leuven", href: LINKS.kuleuven },
  { label: "ORCID", href: LINKS.orcid },
  { label: "GitHub", href: LINKS.github },
  { label: "LinkedIn", href: LINKS.linkedin },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <a href="/" class="footer-brand" aria-label={`${SITE.name}, home`}>
      <Monogram size={44} />
    </a>
    <ul class="footer-links">
      {
        social.map((l) => (
          <li>
            <a
              href={l.href}
              rel={l.href.startsWith("mailto:") ? undefined : "me noopener"}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap">
    <p class="footer-base">
      © {year} {SITE.name} · {SITE.location} · Built with{" "}
      <a href="https://astro.build">Astro</a>.
    </p>
  </div>
</footer>

<style>
  /* Dark band, always, in both themes. */
  .site-footer {
    --mark-ink: #f3f4f6;
    --mark-paper: var(--footer-bg);
    margin-top: 3rem;
    padding-block: 2.5rem 1.5rem;
    background: var(--footer-bg);
    color: #d6dbe2;
  }
  .site-footer a {
    color: inherit;
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  .footer-brand {
    display: block;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-links a {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .footer-links a:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .footer-base {
    margin: 2rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.85rem;
    color: #9aa3b2;
  }
</style>
