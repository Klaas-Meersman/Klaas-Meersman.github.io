---
import { SITE, NAV } from "../consts";

// The current path, so we can highlight the active nav item.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">{SITE.name}</a>
    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => {
            const target = item.href.replace(/\/$/, "") || "/";
            const isActive =
              target === "/" ? path === "/" : path.startsWith(target);
            return (
              <li>
                <a href={item.href} aria-current={isActive ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem 2rem;
    min-height: 3.9rem;
    padding-block: 0.6rem;
  }
  .brand {
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
  }
  nav {
    margin-right: auto;
  }
  nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    background: var(--bg-soft);
  }
  nav a[aria-current="page"] {
    background: var(--bg-soft);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  /* Wide screens: same three columns as the page, so the name lines up with
     the profile card and the nav with the main text. */
  @media (min-width: 70rem) {
    .header-inner {
      display: grid;
      grid-template-columns: var(--columns);
      column-gap: var(--gutter);
    }
    nav {
      margin: 0 0 0 -0.7rem;
    }
  }

  /* Narrow screens: name on the first row, nav scrolls below. */
  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: wrap;
    }
    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none; /* still scrolls by swiping */
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      gap: 0;
    }
    nav a {
      padding-inline: 0.5rem;
      font-size: 0.92rem;
    }
  }
</style>
