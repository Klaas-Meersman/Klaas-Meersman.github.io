---
import { SITE, NAV, LINKS } from "../consts";
import Monogram from "./Monogram.astro";

// The current path, so we can highlight the active nav item.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
      <Monogram size={36} />
      <span class="brand-name">{SITE.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => {
            const target = item.href.replace(/\/$/, "") || "/";
            const isActive =
              target === "/" ? path === "/" : path.startsWith(target);
            return (
              <li>
                <a href={item.href} aria-current={isActive ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <a class="btn btn-icon" href={LINKS.email} aria-label="Email" title="Email">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5.5h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1zM2.6 6.4l9.4 6.6 9.4-6.6"
        ></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem 2rem;
    min-height: 3.9rem;
    padding-block: 0.6rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    text-decoration: none;
  }
  .brand-name {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  nav {
    margin-right: auto;
  }
  nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    background: var(--bg-soft);
  }
  nav a[aria-current="page"] {
    background: var(--bg-soft);
    box-shadow: inset 0 -2px 0 var(--text);
  }

  /* Narrow screens: logo and Email button on the first row, nav scrolls below. */
  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: wrap;
      justify-content: space-between;
    }
    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
    }
    nav ul {
      gap: 0;
    }
    nav a {
      padding-inline: 0.5rem;
      font-size: 0.92rem;
    }
  }
</style>
