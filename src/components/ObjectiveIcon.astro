---
// Small icon for one research objective (see src/data/objectives.ts).
// Inline SVG so the colours follow the site's light / dark theme.
interface Props {
  name: "twin" | "vr" | "metrics" | "control";
  label: string; // read out by screen readers instead of the icon
}
const { name, label } = Astro.props;
---

<svg class="ic" viewBox="0 0 48 48" role="img" aria-label={label}>
  {
    name === "twin" && (
      <>
        {/* A room and its dashed digital copy */}
        <rect class="ln dash" x="17" y="7" width="24" height="24" rx="2" />
        <rect class="ln fill-bg" x="7" y="17" width="24" height="24" rx="2" />
        <rect class="light" x="12" y="23" width="7" height="9" />
        <rect class="ln thin" x="12" y="23" width="7" height="9" />
      </>
    )
  }
  {
    name === "vr" && (
      <>
        {/* VR headset with lit lenses */}
        <path class="ln" d="M4 24 H8 M40 24 H44" />
        <rect class="ln fill-soft" x="8" y="14" width="32" height="20" rx="6" />
        <circle class="light" cx="17" cy="23" r="4.5" />
        <circle class="light" cx="31" cy="23" r="4.5" />
        <circle class="ln thin" cx="17" cy="23" r="4.5" />
        <circle class="ln thin" cx="31" cy="23" r="4.5" />
        <path class="ln thin" d="M20 34 Q24 30 28 34" />
      </>
    )
  }
  {
    name === "metrics" && (
      <>
        {/* Gauge */}
        <path class="light-stroke" d="M10 34 A14 14 0 0 1 24 20" />
        <path class="ln" d="M7 34 A17 17 0 0 1 41 34" />
        <path class="ln thin" d="M6 38 H42" />
        <path class="ln" d="M24 34 L33 24" />
        <circle class="dot" cx="24" cy="34" r="2.6" />
      </>
    )
  }
  {
    name === "control" && (
      <>
        {/* Three sliders */}
        <path class="ln thin" d="M12 8 V40 M24 8 V40 M36 8 V40" />
        <circle class="ln fill-bg" cx="12" cy="28" r="4" />
        <circle class="light ln" cx="24" cy="16" r="4" />
        <circle class="ln fill-bg" cx="36" cy="32" r="4" />
      </>
    )
  }
</svg>

<style>
  .ic {
    display: block;
    width: 100%;
    height: 100%;
    --ic-light: #f4b740;
    --ic-light-a: 0.55;
  }
  @media (prefers-color-scheme: dark) {
    .ic {
      --ic-light: #ffc95c;
      --ic-light-a: 0.8;
    }
  }
  .ln {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thin {
    stroke-width: 1.6;
  }
  .dash {
    stroke-dasharray: 3.5 3;
  }
  .fill-bg {
    fill: var(--bg-soft);
  }
  .fill-soft {
    fill: var(--accent-soft);
  }
  .light {
    fill: var(--ic-light);
    fill-opacity: var(--ic-light-a);
  }
  .light.ln {
    fill-opacity: 1;
  }
  .light-stroke {
    fill: none;
    stroke: var(--ic-light);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .dot {
    fill: var(--accent);
  }
</style>
