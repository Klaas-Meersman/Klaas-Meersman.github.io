---
// Small schematic diagram for one research objective (see src/data/objectives.ts).
// Inline SVG so the colours follow the site's light / dark theme.
interface Props {
  name: "twin" | "vr" | "metrics" | "control";
  label: string; // read out by screen readers instead of the drawing
}
const { name, label } = Astro.props;
---

<svg class="dg" viewBox="0 0 160 100" role="img" aria-label={label}>
  {
    name === "twin" && (
      <>
        {/* Real room: window, ceiling lamp, light cone */}
        <polygon class="light" points="41,34 51,34 58,78 34,78" />
        <rect class="ln" x="12" y="24" width="52" height="54" />
        <rect class="ln" x="18" y="36" width="12" height="16" />
        <path class="ln thin" d="M24 36 V52 M18 44 H30" />
        <path class="ln" d="M46 24 V30 M43 30 H49 L52 34 H40 Z" />
        {/* Arrows between reality and model */}
        <path class="ln" d="M70 46 H89 M85 42 L89 46 L85 50" />
        <path class="ln" d="M90 56 H71 M75 52 L71 56 L75 60" />
        {/* Digital twin: same room as a dashed wireframe with a mesh */}
        <path class="ln faint" d="M113.3 24 V78 M130.6 24 V78 M96 42 H148 M96 60 H148" />
        <polygon class="ln dash" points="125,34 135,34 142,78 118,78" />
        <rect class="ln dash" x="96" y="24" width="52" height="54" />
        <rect class="ln dash" x="102" y="36" width="12" height="16" />
        <path class="ln dash" d="M130 24 V30 M127 30 H133 L136 34 H124 Z" />
        <text x="38" y="93">real room</text>
        <text x="122" y="93">digital twin</text>
      </>
    )
  }
  {
    name === "vr" && (
      <>
        {/* Real lamp shining on an eye */}
        <polygon class="light" points="28,30 40,30 46,62 22,62" />
        <path class="ln" d="M34 18 V24 M30 24 H38 L42 30 H26 Z" />
        <path class="ln fill-bg" d="M22 66 Q34 56 46 66 Q34 76 22 66 Z" />
        <circle class="dot" cx="34" cy="66" r="3.2" />
        {/* Equal exposure */}
        <path class="ln" d="M72 60 H88 M72 67 H88" />
        {/* VR headset with lit lenses */}
        <path class="ln" d="M98 62 H104 M144 62 H150" />
        <rect class="ln fill-soft" x="104" y="50" width="40" height="24" rx="7" />
        <circle class="light ln" cx="116" cy="62" r="5.5" />
        <circle class="light ln" cx="132" cy="62" r="5.5" />
        <path class="ln thin" d="M118 74 Q124 69 130 74" />
        <text x="34" y="93">real exposure</text>
        <text x="124" y="93">in VR</text>
      </>
    )
  }
  {
    name === "metrics" && (
      <>
        {/* Top-down room with uneven pools of light */}
        <rect class="fill-bg ln" x="12" y="20" width="56" height="58" />
        <circle class="light" cx="28" cy="36" r="12" opacity="0.9" />
        <circle class="light" cx="52" cy="58" r="15" opacity="0.55" />
        <circle class="light" cx="27" cy="66" r="7" opacity="0.3" />
        <rect class="ln" x="12" y="20" width="56" height="58" />
        <path class="ln" d="M76 49 H90 M86 45 L90 49 L86 53" />
        {/* Several metrics, compared */}
        <path class="ln thin muted" d="M98 20 V78 H150" />
        <rect class="ln fill-soft" x="104" y="48" width="10" height="30" />
        <rect class="ln fill-accent" x="120" y="34" width="10" height="44" />
        <rect class="ln fill-soft" x="136" y="56" width="10" height="22" />
        <text x="40" y="93">non-uniform light</text>
        <text x="124" y="93">metrics</text>
      </>
    )
  }
  {
    name === "control" && (
      <>
        {/* Control strategy (steps) tracking the optimal benchmark (dashed) */}
        <path class="ln thin muted" d="M16 18 V78 H150" />
        <path class="ln dash muted" d="M16 60 C40 26 64 28 86 50 S130 74 150 40" />
        <path class="ln" d="M16 62 H28 V45 H42 V36 H60 V37 H74 V44 H88 V52 H102 V61 H118 V64 H132 V58 H142 V46 H150" />
        <path class="ln dash muted" d="M24 90 H38" />
        <text x="41" y="93" class="start">optimal</text>
        <path class="ln" d="M86 90 H100" />
        <text x="103" y="93" class="start">strategy</text>
      </>
    )
  }
</svg>

<style>
  .dg {
    display: block;
    width: 100%;
    height: auto;
    --dg-light: #f4b740;
    --dg-light-a: 0.45;
  }
  @media (prefers-color-scheme: dark) {
    .dg {
      --dg-light: #ffc95c;
      --dg-light-a: 0.75;
    }
  }
  .ln {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thin {
    stroke-width: 1.4;
  }
  .dash {
    stroke-dasharray: 4 3;
  }
  .faint {
    stroke-width: 1;
    stroke-opacity: 0.35;
  }
  .muted {
    stroke: var(--text-soft);
  }
  .light {
    fill: var(--dg-light);
    fill-opacity: var(--dg-light-a);
  }
  .fill-bg {
    fill: var(--bg);
  }
  .fill-soft {
    fill: var(--accent-soft);
  }
  .fill-accent {
    fill: var(--accent);
  }
  .dot {
    fill: var(--accent);
  }
  text {
    font: 8.5px var(--font-sans);
    fill: var(--text-soft);
    text-anchor: middle;
  }
  text.start {
    text-anchor: start;
  }
</style>
